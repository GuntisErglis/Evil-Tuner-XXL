+/* Evil Tuner XXL: the network interface that carries the default route (the Wi-Fi or hotspot an iPhone uses), from
+ * /proc/net/route; "" when there is none. A device can have several interfaces (USB networking, tunnels, a second
+ * radio): the device ID, the Apple-Response and the mDNS addresses must all be the ones of the interface the phone
+ * can reach. */
+int et_default_interface(char *name, size_t len) {
+  name[0] = 0;
+  FILE *f = fopen("/proc/net/route", "r");
+  if (f == NULL)
+    return 0;
+  char line[256];
+  int found = 0;
+  if (fgets(line, sizeof(line), f) != NULL) {
+    while (!found && fgets(line, sizeof(line), f) != NULL) {
+      char ifn[64];
+      unsigned long dest = 1, flags = 0;
+      if (sscanf(line, "%63s %lx %*x %lx", ifn, &dest, &flags) == 3 && dest == 0 && (flags & 1)) {
+        snprintf(name, len, "%s", ifn);
+        found = 1;
+      }
+    }
+  }
+  fclose(f);
+  return found;
+}
